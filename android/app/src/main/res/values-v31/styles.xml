<resources>

    <!-- API 31+ (Android 12+): system SplashScreen API. Full TronLink banner centered on white. -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_banner</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/white</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

</resources>
